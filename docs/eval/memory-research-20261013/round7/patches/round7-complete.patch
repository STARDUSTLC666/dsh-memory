diff --git a/md_cg/evidence_budget.py b/md_cg/evidence_budget.py
new file mode 100644
index 0000000..0696cc1
--- /dev/null
+++ b/md_cg/evidence_budget.py
@@ -0,0 +1,219 @@
+"""Opt-in atomic evidence delivery; pure functions, no production hooks.
+
+Callers MUST supply nodes already authorized by MdCGSecure / the MCP server.
+This module does not read a graph, grant permissions, alter source content,
+rank candidates, or certify truth. Default-off delegates to the legacy helper.
+Enabled mode factors equal metadata, retains whole selected source documents,
+and reports INCOMPLETE instead of silently clipping facts or counterevidence.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+
+from md_cg.evidence_delivery import deliver
+from md_cg.experience_consolidation import context_verdict
+
+MAX_RECORDS = 128
+MAX_SOURCE_CHARS = 1_000_000
+_SECRET_KEYS = frozenset(('api_key', 'apikey', 'access_token', 'refresh_token',
+                         'password', 'private_key', 'secret_key', 'credential',
+                         'credentials', 'authorization', 'bearer_token'))
+
+
+def _json(value):
+    return json.dumps(value, ensure_ascii=False, sort_keys=True,
+                      separators=(',', ':'), allow_nan=False)
+
+
+def _hash(text):
+    return hashlib.sha256(text.encode('utf8')).hexdigest()
+
+
+def _has_credential_key(value):
+    if isinstance(value, dict):
+        return any(str(k).lower().replace('-', '_') in _SECRET_KEYS or
+                   _has_credential_key(v) for k, v in value.items())
+    if isinstance(value, (list, tuple)):
+        return any(_has_credential_key(v) for v in value)
+    return False
+
+
+def _project(node):
+    """Project the existing RSI source schema, or keep an ordinary node whole."""
+    body = node.get('content')
+    if not isinstance(body, str) or not isinstance(node.get('id'), str):
+        raise ValueError('invalid_authorized_node')
+    fm = node.get('frontmatter') or {}
+    trace = None
+    try:
+        candidate = json.loads(body)
+        if isinstance(candidate, dict) and 'source_document' in candidate:
+            if not isinstance(candidate['source_document'], str):
+                raise ValueError('invalid_source_document')
+            trace = candidate
+    except json.JSONDecodeError:
+        pass
+    source = trace['source_document'] if trace else body
+    cs = fm.get('condition_space') or {}
+    if not isinstance(cs, dict):
+        raise ValueError('invalid_condition_space')
+    # Native mdcg.add documents time_window as observation time, not expiry.
+    conditions = {k: v for k, v in cs.items() if k != 'time_window'}
+    metadata = {'applicability_conditions': conditions,
+                'non_applicable_conditions': fm.get('non_applicable_conditions') or [],
+                'verification_state': fm.get('verification_state', 'unverified')}
+    if cs.get('time_window') is not None:
+        metadata['observation_time_window'] = cs['time_window']
+    if fm.get('created_at') is not None:
+        metadata['memory_created_at'] = fm['created_at']
+    for key in ('effective_from', 'effective_until', 'believed_at', 'version',
+                'source_version', 'verification_basis'):
+        if fm.get(key) is not None:
+            metadata[key] = fm[key]
+    comment = (fm.get('state_attributes') or {}).get('comment')
+    if comment:
+        metadata['condition_comment'] = comment
+    if trace:
+        metadata.update(recorded_scope=trace.get('context'),
+                        source_recorded_at=trace.get('timestamp'),
+                        source_reference=trace.get('source'),
+                        source_origin=trace.get('task_id'),
+                        source_receipt_sha256=trace.get('raw_result_sha256'))
+    elif fm.get('source') is not None:
+        metadata['source'] = fm['source']
+    # Credentials never become diagnostic text. A credential-bearing necessary
+    # condition cannot be silently removed: refuse the entire fact bundle.
+    if _has_credential_key(metadata):
+        raise ValueError('credential_metadata_disallowed')
+    _json(metadata)
+    return {'id': node['id'], 'source': source, 'metadata': metadata,
+            'source_sha256': _hash(source), 'trace_sha256': _hash(body)}
+
+
+def _legacy(nodes, query, facts):
+    rows = []
+    for node in nodes:
+        fm = dict(node.get('frontmatter') or {})
+        content = node.get('content') or ''
+        try:
+            trace = json.loads(content)
+        except (json.JSONDecodeError, TypeError):
+            trace = None
+        qual = {'state': 'DEFER'}
+        if isinstance(trace, dict) and isinstance(trace.get('source_document'), str):
+            content = trace['source_document']
+            fm.update(created_at=trace.get('timestamp'),
+                      source={'origin': 'A-session:'+trace['task_id'],
+                              'receipt_sha256': trace['raw_result_sha256'],
+                              'reference': trace['source']},
+                      condition_space=trace.get('context'),
+                      verification_state='unverified')
+            qual = context_verdict(trace.get('context'), facts)
+        rows.append(({'id': node['id'], 'content': content, 'frontmatter': fm},
+                     0, {'state': qual.get('state')}, []))
+    rendered = deliver(rows, query, budget_tokens=750, max_item_tokens=450,
+                       mode='query_metadata_compact')
+    value = {'text': rendered['text'],
+             'delivered_ids': [r['id'] for r in rendered['records']],
+             'rejected_ids': [], 'evidence_status': 'unverified-source-data'}
+    return value, {'enabled': False, 'mode': 'legacy', 'records': rendered['records']}
+
+
+def deliver_evidence(nodes, query, *, facts=None, budget_tokens=750,
+                     token_counter=None, enabled=False):
+    """Return (tool value, body-free diagnostics), preserving candidate order.
+
+Enabled budgets count the COMPLETE serialized tool value via an injected model
+tokenizer. A zero/tiny budget that cannot encode the control envelope is an
+explicit error. COMPLETE_SOURCE_BUNDLE describes delivery, not truth or scope.
+No selected source or native condition is clipped to fit the budget.
+"""
+    nodes = list(nodes)
+    if not enabled:
+        return _legacy(nodes, query, facts)
+    if type(budget_tokens) is not int or budget_tokens < 0:
+        raise ValueError('invalid_evidence_budget')
+    if not callable(token_counter):
+        raise ValueError('enabled_delivery_requires_model_token_counter')
+
+    def count(value):
+        # Match the actual tool renderer's insertion-order JSON serialization.
+        n = token_counter(json.dumps(value, ensure_ascii=False,
+                                     separators=(',', ':'), allow_nan=False))
+        if type(n) is not int or n < 0:
+            raise ValueError('invalid_token_counter_result')
+        return n
+
+    empty = {'text': '', 'delivered_ids': [], 'rejected_ids': [],
+             'evidence_status': 'INCOMPLETE'}
+    if count(empty) > budget_tokens:
+        raise ValueError('budget_below_control_envelope_minimum')
+    diagnostics = {'enabled': True, 'mode': 'atomic-shared-metadata',
+                   'budget_tokens': budget_tokens,
+                   'token_measure': 'injected_complete_response_tokenizer',
+                   'records': [], 'duplicate_occurrences': 0,
+                   'ordinary_diagnostic_contains_body': False}
+
+    def incomplete(reason, required_tokens=None):
+        value = dict(empty)
+        value['text'] = 'DEFER: '+reason
+        if count(value) > budget_tokens:
+            value['text'] = ''
+        diagnostics.update(overflow=True, overflow_reason=reason,
+                           required_response_tokens=required_tokens,
+                           response_tokens=count(value), delivered_ids=[])
+        return value, diagnostics
+
+    if len(nodes) > MAX_RECORDS:
+        return incomplete('selected_record_resource_limit')
+    projected, seen = [], {}
+    try:
+        for node in nodes:
+            record = _project(node)
+            fingerprint = _hash(_json(record))
+            if record['id'] in seen:
+                if seen[record['id']] != fingerprint:
+                    return incomplete('same_id_source_version_conflict')
+                diagnostics['duplicate_occurrences'] += 1
+                continue
+            seen[record['id']] = fingerprint
+            projected.append(record)
+    except (ValueError, TypeError, AttributeError):
+        # Never include exception text: it could contain source/metadata values.
+        return incomplete('invalid_or_disallowed_source_metadata')
+    if sum(len(r['source']) for r in projected) > MAX_SOURCE_CHARS:
+        return incomplete('source_character_resource_limit')
+    common = {}
+    if len(projected) > 1:
+        first = projected[0]['metadata']
+        for key, value in first.items():
+            if all(key in r['metadata'] and _json(r['metadata'][key]) == _json(value)
+                   for r in projected[1:]):
+                common[key] = value
+    blocks = []
+    if projected:
+        blocks.append('Selected source records. observation_time_window records observation, not automatic expiry. Apply explicit effective dates and all conditions.')
+    if common:
+        blocks.append('Shared metadata: '+_json(common))
+    for record in projected:
+        remaining = {k: v for k, v in record['metadata'].items() if k not in common}
+        header = 'Evidence ID: '+record['id']
+        if remaining:
+            header += '\nMetadata: '+_json(remaining)
+        blocks.append(header+'\nSource document (complete):\n'+record['source'])
+    value = {'text': '\n\n'.join(blocks),
+             'delivered_ids': [r['id'] for r in projected],
+             'rejected_ids': [], 'evidence_status': 'COMPLETE_SOURCE_BUNDLE'}
+    required = count(value)
+    diagnostics['required_response_tokens'] = required
+    diagnostics['records'] = [{'id': r['id'], 'source_sha256': r['source_sha256'],
+                               'trace_sha256': r['trace_sha256'],
+                               'metadata_sha256': _hash(_json(r['metadata'])),
+                               'spans': [{'start': 0, 'end': len(r['source'])}],
+                               'truncated': False} for r in projected]
+    if required > budget_tokens:
+        return incomplete('complete_evidence_bundle_over_budget', required)
+    diagnostics.update(overflow=False, response_tokens=required,
+                       delivered_ids=value['delivered_ids'], shared_metadata_fields=list(common))
+    return value, diagnostics
