diff --git a/md_cg/evidence_preserving.py b/md_cg/evidence_preserving.py
new file mode 100644
index 0000000..fe4398e
--- /dev/null
+++ b/md_cg/evidence_preserving.py
@@ -0,0 +1,155 @@
+"""Opt-in source-atomic MCP delivery, after existing authorization/selection.
+
+No retrieval, ranking, writes, permission decisions or truth certification.
+Do not call assemble with unauthorized nodes. from_recall rechecks Secure.get
+for every selected ID. A partial bundle is withheld, never silently clipped.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+
+from .mdcos import est_tokens
+
+_CREDENTIAL_KEYS = frozenset(('api_key', 'apikey', 'access_token', 'refresh_token',
+    'password', 'private_key', 'secret_key', 'credential', 'credentials',
+    'authorization', 'bearer_token'))
+_TRACE_REQUIRED = frozenset(('source_document', 'context', 'timestamp',
+                             'task_id', 'source', 'raw_result_sha256'))
+_TRACE_ALLOWED = _TRACE_REQUIRED | frozenset(('candidate_note', 'events', 'observations'))
+
+
+def _json(value):
+    return json.dumps(value, ensure_ascii=False, separators=(',', ':'), allow_nan=False)
+
+
+def _sha(text):
+    return hashlib.sha256(text.encode('utf8')).hexdigest()
+
+
+def _unsafe_metadata(value):
+    if isinstance(value, dict):
+        return any(str(k).lower().replace('-', '_') in _CREDENTIAL_KEYS or
+                   _unsafe_metadata(v) for k, v in value.items())
+    if isinstance(value, (tuple, list)):
+        return any(_unsafe_metadata(v) for v in value)
+    return False
+
+
+def _project(node):
+    body = node.get('content')
+    if not isinstance(body, str) or not isinstance(node.get('id'), str):
+        raise ValueError('invalid_source')
+    fm = node.get('frontmatter') or {}
+    cs = fm.get('condition_space') or {}
+    if not isinstance(cs, dict):
+        raise ValueError('invalid_conditions')
+    metadata = {'applicability_conditions': {k: v for k, v in cs.items() if k != 'time_window'},
+                'non_applicable_conditions': fm.get('non_applicable_conditions') or [],
+                'verification_state': fm.get('verification_state', 'unverified')}
+    if 'time_window' in cs:
+        metadata['observation_time_window'] = cs['time_window']
+    # Whitelist evidence fields; identity/token/crypto internals are never copied.
+    for key in ('created_at', 'source', 'effective_from', 'effective_until',
+                'believed_at', 'version', 'source_version', 'verification_basis'):
+        if fm.get(key) is not None:
+            metadata[key] = fm[key]
+    comment = (fm.get('state_attributes') or {}).get('comment')
+    if comment:
+        metadata['condition_comment'] = comment
+    try:
+        trace = json.loads(body)
+    except json.JSONDecodeError:
+        trace = None
+    # source_document is also a legitimate arbitrary JSON key. Only project the
+    # known complete trace schema; unknown fields may be decisive counterevidence.
+    # Older/ordinary JSON remains a whole source, rather than silently dropping it.
+    known_trace = (isinstance(trace, dict) and _TRACE_REQUIRED <= trace.keys()
+                   and trace.keys() <= _TRACE_ALLOWED)
+    if known_trace:
+        if not isinstance(trace['source_document'], str):
+            raise ValueError('invalid_trace_source')
+        body = trace['source_document']
+        for old, new in (('context', 'recorded_scope'), ('timestamp', 'source_recorded_at'),
+                         ('task_id', 'source_origin'), ('source', 'source_reference'),
+                         ('raw_result_sha256', 'source_receipt_sha256')):
+            if trace.get(old) is not None:
+                metadata[new] = trace[old]
+    if _unsafe_metadata(metadata):
+        raise ValueError('disallowed_metadata')
+    return {'id': node['id'], 'content': body, 'metadata': metadata,
+            'source_sha256': _sha(body), 'truncated': False}
+
+
+def assemble(nodes, *, budget_tokens=1200, token_counter=None):
+    """Return (visible tool response, body-free experiment diagnostics).
+
+Default counter is explicitly the project ESTIMATOR. Callers may inject a
+model tokenizer. Both count the entire serialized tool response. The API's
+billed usage remains authoritative. Completeness covers selected sources only.
+"""
+    if type(budget_tokens) is not int or budget_tokens < 0:
+        raise ValueError('invalid_evidence_budget')
+    counter = token_counter or est_tokens
+    measure = 'injected_complete_response_tokenizer' if token_counter else 'project_estimator'
+
+    def count(value):
+        n = counter(_json(value))
+        if type(n) is not int or n < 0:
+            raise ValueError('invalid_token_counter')
+        return n
+
+    empty = {'pack': [], 'evidence_status': 'INCOMPLETE'}
+    if count(empty) > budget_tokens:
+        raise ValueError('budget_below_control_envelope_minimum')
+    audit = {'mode': 'source-atomic-v1', 'budget': budget_tokens,
+             'token_measure': measure, 'records': [], 'selected_ids': []}
+
+    def defer(reason):
+        audit.update(reason=reason, delivered_ids=[], tokens_used=count(empty))
+        return dict(empty), audit
+
+    records, seen, chars = [], {}, 0
+    try:
+        for node in nodes:
+            if len(records) >= 128:
+                return defer('selected_record_resource_limit')
+            record = _project(node)
+            digest = _sha(_json(record))
+            if record['id'] in seen:
+                if seen[record['id']] != digest:
+                    return defer('same_id_source_version_conflict')
+                continue
+            seen[record['id']] = digest
+            chars += len(record['content'])
+            if chars > 1_000_000:
+                return defer('source_character_resource_limit')
+            records.append(record)
+    except (ValueError, TypeError, AttributeError, RecursionError):
+        return defer('invalid_or_disallowed_source_metadata')
+    audit['selected_ids'] = [r['id'] for r in records]
+    audit['records'] = [{'id': r['id'], 'source_sha256': r['source_sha256'],
+                         'metadata_sha256': _sha(_json(r['metadata'])),
+                         'spans': [{'start': 0, 'end': len(r['content'])}],
+                         'truncated': False} for r in records]
+    value = {'pack': records, 'evidence_status': 'COMPLETE_SOURCE_BUNDLE' if records else 'INSUFFICIENT'}
+    required = count(value)
+    audit['required_tokens'] = required
+    if required > budget_tokens:
+        return defer('complete_bundle_over_budget')
+    audit.update(reason=None, delivered_ids=[r['id'] for r in records], tokens_used=required)
+    return value, audit
+
+
+def from_recall(cg, recalled, budget_tokens, token_counter=None):
+    """Use the authoritative graph; never reuse cached/plaintext clipped bodies."""
+    nodes = []
+    for item in recalled.get('pack', []):
+        node = cg.get(item['id'])
+        if node is None:
+            value, audit = assemble([], budget_tokens=budget_tokens, token_counter=token_counter)
+            value['evidence_status'] = 'INCOMPLETE'
+            audit['reason'] = 'visibility_changed_before_delivery'
+            return value, audit
+        nodes.append(node)
+    return assemble(nodes, budget_tokens=budget_tokens, token_counter=token_counter)
