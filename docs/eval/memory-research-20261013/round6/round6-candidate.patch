+class AtomicBudgetTests(unittest.TestCase):
+    def node(self, nid='one', text='Label Q. Never use when emergency=true.'):
+        return {'id': nid, 'content': text, 'frontmatter': {
+            'source': 'fixture-source', 'created_at': 100,
+            'condition_space': {'department': 'ops', 'time_window': [100, 200]},
+            'non_applicable_conditions': ['emergency=true'],
+            'effective_until': '2027-01-01', 'verification_state': 'unverified'}}
+
+    def render(self, nodes, budget=20000, **kw):
+        # Character count is intentionally a strict injected stand-in here;
+        # experiment validation additionally uses the pinned model tokenizer.
+        return deliver_evidence(nodes, 'Label', enabled=True,
+                                budget_tokens=budget, token_counter=len, **kw)
+
+    def test_default_off_uses_existing_legacy_projection(self):
+        node=self.node();v,d=deliver_evidence([node], 'Label')
+        old=deliver([(node,0,{'state':'DEFER'},[])], 'Label',budget_tokens=750,
+                    max_item_tokens=450,mode='query_metadata_compact')
+        self.assertEqual(v['text'],old['text']);self.assertFalse(d['enabled'])
+
+    def test_full_fact_negative_and_distinct_time_semantics(self):
+        n=self.node();v,d=self.render([n])
+        self.assertIn(n['content'],v['text'])
+        for part in ('emergency=true','observation_time_window','applicability_conditions','effective_until','fixture-source'):
+            self.assertIn(part,v['text'])
+        self.assertEqual(d['records'][0]['spans'],[{'start':0,'end':len(n['content'])}])
+        self.assertEqual(d['records'][0]['source_sha256'],hashlib.sha256(n['content'].encode()).hexdigest())
+        self.assertFalse(d['overflow'])
+
+    def test_overflow_exposes_no_partial_fact_or_counterevidence(self):
+        first=self.node('one','The allowed label is Q.')
+        second=self.node('two','Contradiction: the label is R. '+'background '*300)
+        v,d=self.render([first,second],budget=250)
+        self.assertEqual(v['evidence_status'],'INCOMPLETE');self.assertEqual(v['delivered_ids'],[])
+        self.assertNotIn('label is Q',v['text']);self.assertNotIn('label is R',v['text'])
+        self.assertTrue(d['overflow']);self.assertLessEqual(d['response_tokens'],250)
+
+    def test_exact_budget_boundary_counts_full_response(self):
+        v,d=self.render([self.node()]);needed=d['required_response_tokens']
+        exact,ed=self.render([self.node()],budget=needed)
+        short,sd=self.render([self.node()],budget=needed-1)
+        self.assertEqual(exact,v);self.assertFalse(ed['overflow'])
+        self.assertEqual(short['evidence_status'],'INCOMPLETE');self.assertTrue(sd['overflow'])
+
+    def test_equal_metadata_factored_without_merging_different_evidence(self):
+        nodes=[self.node('one','Q is proposed.'),self.node('two','R is confirmed.')]
+        v,d=self.render(nodes)
+        self.assertEqual(v['delivered_ids'],['one','two'])
+        self.assertEqual(v['text'].count('fixture-source'),1)
+        self.assertIn('Q is proposed.',v['text']);self.assertIn('R is confirmed.',v['text'])
+        self.assertIn('source',d['shared_metadata_fields'])
+
+    def test_duplicate_id_requires_same_source_and_metadata(self):
+        n=self.node();v,d=self.render([n,n])
+        self.assertEqual(v['delivered_ids'],['one']);self.assertEqual(d['duplicate_occurrences'],1)
+        v,d=self.render([n,self.node('one','A changed source version.')])
+        self.assertEqual(v['evidence_status'],'INCOMPLETE')
+        self.assertEqual(d['overflow_reason'],'same_id_source_version_conflict')
+
+    def test_non_decision_credentials_not_serialized_and_necessary_credential_fails_closed(self):
+        n=self.node();n['frontmatter']['access_token']='synthetic-hidden-value'
+        v,d=self.render([n]);self.assertNotIn('synthetic-hidden-value',json.dumps([v,d]))
+        n['frontmatter']['condition_space']['access_token']='synthetic-hidden-value'
+        v,d=self.render([n]);self.assertEqual(v['evidence_status'],'INCOMPLETE')
+        self.assertNotIn('synthetic-hidden-value',json.dumps([v,d]))
+
+    def test_diagnostics_contain_hashes_but_no_body_or_condition_values(self):
+        n=self.node(text='SYNTHETIC-SENSITIVE-BODY');v,d=self.render([n])
+        self.assertIn(n['content'],v['text'])
+        raw=json.dumps(d);self.assertNotIn(n['content'],raw);self.assertNotIn('department',raw)
+        self.assertFalse(d['ordinary_diagnostic_contains_body'])
+
+    def test_rsi_trace_projects_source_and_retains_native_negatives(self):
+        n=self.node();trace={'source_document':'Exact source fact.','context':{'project':'Q'},'task_id':'A','source':'A-record','timestamp':'2026-01-01','raw_result_sha256':'a'*64,'observations':['large discarded diagnostic '*100]}
+        n['content']=json.dumps(trace)
+        v,d=self.render([n]);self.assertIn('Exact source fact.',v['text'])
+        self.assertIn('emergency=true',v['text']);self.assertIn('a'*64,v['text'])
+        self.assertNotIn('large discarded diagnostic',v['text'])
+
+    def test_malformed_sources_and_counter_arguments_fail_explicitly(self):
+        n=self.node();n['content']=json.dumps({'source_document':['not text']})
+        v,d=self.render([n]);self.assertEqual(v['evidence_status'],'INCOMPLETE')
+        for budget in (-1,0,True,1.5):
+            with self.assertRaises(ValueError):self.render([self.node()],budget=budget)
+        with self.assertRaises(ValueError):deliver_evidence([self.node()],'x',enabled=True)
+        with self.assertRaises(ValueError):deliver_evidence([self.node()],'x',enabled=True,token_counter=lambda _: True)
+
+    def test_concurrent_calls_do_not_mutate_inputs_or_share_identity(self):
+        from concurrent.futures import ThreadPoolExecutor
+        n=self.node();before=json.dumps(n,sort_keys=True)
+        with ThreadPoolExecutor(max_workers=4) as pool:outputs=list(pool.map(lambda _:self.render([n])[0],range(16)))
+        self.assertTrue(all(o==outputs[0] for o in outputs))
+        self.assertEqual(json.dumps(n,sort_keys=True),before)
+
+
 if __name__ == '__main__':
     unittest.main(verbosity=2)
