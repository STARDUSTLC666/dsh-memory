+++ b/md_cg/test_evidence_preserving.py
@@ -0,0 +1,129 @@
+"""Executable source/conditions/budget counterexamples for opt-in delivery."""
+import copy
+import hashlib
+import json
+import unittest
+
+from . import mcp_server
+from .mdcos import est_tokens
+
+
+class AuthorizedGraph:
+    def __init__(self, nodes):
+        self.nodes = nodes
+        self.calls = []
+
+    def get(self, nid):
+        self.calls.append(nid)
+        return copy.deepcopy(self.nodes.get(nid))
+
+
+class PreservingDeliveryTests(unittest.TestCase):
+    def node(self, nid='record', content='The recorded value is 7.'):
+        return {'id': nid, 'content': content, 'frontmatter': {
+            'created_at': 100, 'source': {'reference': 'public-source', 'version': 'v1'},
+            'condition_space': {'platform': 'Windows', 'time_window': [100, 200]},
+            'non_applicable_conditions': ['maintenance=true'],
+            'verification_state': 'unverified', 'verification_basis': 'source receipt',
+            'effective_until': '2027-01-01'}}
+
+    def render(self, nodes, budget=10000, counter=len):
+        from .evidence_preserving import assemble
+        return assemble(nodes, budget_tokens=budget, token_counter=counter)
+
+    def test_source_and_all_decisive_metadata_are_not_windowed(self):
+        n = self.node(content='Intro.\n' * 100 + 'Only when mode=legacy; never on Linux.')
+        before = copy.deepcopy(n)
+        value, audit = self.render([n])
+        self.assertEqual(value['evidence_status'], 'COMPLETE_SOURCE_BUNDLE')
+        self.assertEqual(value['pack'][0]['content'], n['content'])
+        m = value['pack'][0]['metadata']
+        self.assertEqual(m['non_applicable_conditions'], ['maintenance=true'])
+        self.assertEqual(m['applicability_conditions'], {'platform': 'Windows'})
+        self.assertEqual(m['observation_time_window'], [100, 200])
+        self.assertEqual(m['effective_until'], '2027-01-01')
+        self.assertEqual(n, before)
+        self.assertNotIn('legacy', json.dumps(audit))
+
+    def test_trace_context_never_overwrites_native_conditions(self):
+        n = self.node(content=json.dumps({'source_document': 'Receipt value 8.',
+            'context': {'release': 'v3'}, 'timestamp': 101, 'task_id': 'session-A',
+            'source': 'source-ref', 'raw_result_sha256': 'a' * 64}))
+        value, _ = self.render([n])
+        m = value['pack'][0]['metadata']
+        self.assertEqual(m['recorded_scope'], {'release': 'v3'})
+        self.assertEqual(m['applicability_conditions'], {'platform': 'Windows'})
+        self.assertEqual(value['pack'][0]['content'], 'Receipt value 8.')
+
+    def test_budget_is_whole_response_not_only_body(self):
+        nodes = [self.node(content='A' * 1200), self.node('counter', 'Counterevidence: value 9.')]
+        value, audit = self.render(nodes, 600)
+        self.assertEqual(value['evidence_status'], 'INCOMPLETE')
+        self.assertEqual(value['pack'], [])
+        self.assertLessEqual(len(json.dumps(value, ensure_ascii=False, separators=(',', ':'))), 600)
+        self.assertEqual(audit['reason'], 'complete_bundle_over_budget')
+        self.assertNotIn('Counterevidence', json.dumps(audit))
+
+    def test_same_id_conflicting_version_refuses_without_picking_one(self):
+        value, _ = self.render([self.node(), self.node(content='value 9')])
+        self.assertEqual(value['evidence_status'], 'INCOMPLETE')
+        self.assertEqual(value['pack'], [])
+
+    def test_same_id_identical_source_dedup_keeps_order(self):
+        n = self.node(); n2 = self.node('two')
+        value, _ = self.render([n, copy.deepcopy(n), n2])
+        self.assertEqual([r['id'] for r in value['pack']], ['record', 'two'])
+
+    def test_credentials_in_necessary_conditions_are_not_silently_removed(self):
+        n = self.node();n['frontmatter']['condition_space']['api_key'] = 'test-secret'
+        value, audit = self.render([n])
+        self.assertEqual(value['evidence_status'], 'INCOMPLETE')
+        self.assertNotIn('test-secret', json.dumps(value)+json.dumps(audit))
+
+    def test_authorized_get_is_required_after_selection_and_visibility_race_fails_closed(self):
+        from .evidence_preserving import from_recall
+        g = AuthorizedGraph({'record': None})
+        value, _ = from_recall(g, {'pack': [{'id': 'record', 'content': 'old visible text'}]}, 300, len)
+        self.assertEqual(g.calls, ['record'])
+        self.assertEqual(value['pack'], [])
+        self.assertEqual(value['evidence_status'], 'INCOMPLETE')
+
+    def test_native_mcp_switch_is_default_off_and_strict_boolean(self):
+        schema = next(t for t in mcp_server.TOOLS if t['name'] == 'mdcg_recall')['inputSchema']
+        self.assertEqual(schema['properties']['preserve_evidence']['type'], 'boolean')
+        self.assertNotIn('preserve_evidence', schema.get('required', []))
+
+    def test_empty_selection_is_insufficient_and_tiny_budget_is_explicit_error(self):
+        value, _ = self.render([])
+        self.assertEqual(value['evidence_status'], 'INSUFFICIENT')
+        with self.assertRaises(ValueError):self.render([self.node()], 0)
+
+    def test_missing_or_invalid_node_is_not_reported_complete(self):
+        for n in ({'id': 'bad', 'content': None}, {'id': 'bad', 'content': 'x', 'frontmatter': {'condition_space': 'bad'}}):
+            value, _ = self.render([n])
+            self.assertEqual(value['evidence_status'], 'INCOMPLETE')
+
+    def test_default_counter_and_unicode_hashes(self):
+        from .evidence_preserving import assemble
+        n = self.node(content='中文证据：👩🏽‍💻\n不要丢弃条件。')
+        value, audit = assemble([n], budget_tokens=1000)
+        self.assertEqual(audit['tokens_used'], est_tokens(json.dumps(value, ensure_ascii=False, separators=(',', ':'))))
+        self.assertEqual(audit['records'][0]['source_sha256'], hashlib.sha256(n['content'].encode('utf8')).hexdigest())
+
+    def test_ordinary_json_source_document_key_does_not_discard_outer_exceptions(self):
+        body = json.dumps({'source_document': 'API result 7',
+                           'exceptions': ['Only valid on offline snapshots.']})
+        value, _ = self.render([self.node(content=body)])
+        self.assertEqual(value['pack'][0]['content'], body)
+
+    def test_unrecognized_trace_fields_preserve_the_entire_original(self):
+        body = json.dumps({'source_document': 'API result 7', 'context': {},
+            'timestamp': 100, 'task_id': 'task-A', 'source': 'source-ref',
+            'raw_result_sha256': 'a' * 64,
+            'important_counterevidence': 'The receipt was retracted.'})
+        value, _ = self.render([self.node(content=body)])
+        self.assertEqual(value['pack'][0]['content'], body)
+
+
+if __name__ == '__main__':
+    unittest.main()
